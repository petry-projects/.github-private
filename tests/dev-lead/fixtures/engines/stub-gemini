#!/usr/bin/env bash
# Configurable via:
#   STUB_ENGINE_RESPONSE, STUB_ENGINE_EXIT, STUB_ENGINE_DELAY
#   STUB_ENGINE_EXIT_BY_MODEL  — pipe-delimited list of "model=exit_code" pairs.
#                                If set and a pair matches --model, that exit
#                                code overrides STUB_ENGINE_EXIT.
#   STUB_ENGINE_RESPONSE_BY_MODEL  — pipe-delimited "model=response" pairs,
#                                    same lookup as EXIT_BY_MODEL.
#   STUB_ENGINE_RECORD_MODELS  — if set to a writable path, every --model value
#                                seen is appended as a new line for inspection.
#   STUB_ENGINE_EXIT_BY_KEY    — pipe-delimited "apikey=exit_code" pairs, matched
#                                against the effective Gemini API key in the env
#                                (GEMINI_API_KEY, else GOOGLE_API_KEY). Takes
#                                precedence over STUB_ENGINE_EXIT_BY_MODEL — used
#                                to exercise multi-key rotation (#1777).
#   STUB_ENGINE_RESPONSE_BY_KEY  — pipe-delimited "apikey=response" pairs, same
#                                  lookup and precedence as EXIT_BY_KEY.
#   STUB_ENGINE_RECORD_KEYS    — if set to a writable path, the effective API key
#                                seen on each call is appended as a new line.
#   STUB_GEMINI_USAGE    — "prompt cached candidates" emitted under
#                          .stats.models.<model>.tokens when --output-format json
#                          is requested. Default "120 20 40".
#   STUB_GEMINI_THOUGHTS — thinking token count added to .tokens.thoughts.
#                          Default 0 (omitted when 0).
model="stub-gemini-model"
output_format="text"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)
      model="$2"; shift; shift ;;
    --output-format)
      output_format="$2"; shift; shift ;;
    --prompt|--approval-mode)
      shift; shift ;;
    *) shift ;;
  esac
done

if [ -n "${STUB_ENGINE_RECORD_MODELS:-}" ]; then
  printf '%s\n' "$model" >> "$STUB_ENGINE_RECORD_MODELS" 2>/dev/null || true
fi

# Effective Gemini API key the CLI would authenticate with (GEMINI_API_KEY wins,
# else GOOGLE_API_KEY) — used for per-key rotation behavior and recording (#1777).
api_key="${GEMINI_API_KEY:-${GOOGLE_API_KEY:-}}"
if [ -n "${STUB_ENGINE_RECORD_KEYS:-}" ]; then
  printf '%s\n' "$api_key" >> "$STUB_ENGINE_RECORD_KEYS" 2>/dev/null || true
fi

sleep "${STUB_ENGINE_DELAY:-0}"

# Resolve response: per-model override → default.
response="${STUB_ENGINE_RESPONSE:-stub engine response}"
if [ -n "${STUB_ENGINE_RESPONSE_BY_MODEL:-}" ] && [ -n "$model" ]; then
  IFS='|' read -ra _pairs <<< "$STUB_ENGINE_RESPONSE_BY_MODEL"
  for _p in "${_pairs[@]}"; do
    case "$_p" in
      "$model="*) response="${_p#"$model="}"; break ;;
    esac
  done
fi
# Per-key override takes precedence over the per-model / default response.
if [ -n "${STUB_ENGINE_RESPONSE_BY_KEY:-}" ] && [ -n "$api_key" ]; then
  IFS='|' read -ra _kpairs <<< "$STUB_ENGINE_RESPONSE_BY_KEY"
  for _kp in "${_kpairs[@]}"; do
    case "$_kp" in
      "$api_key="*) response="${_kp#"$api_key="}"; break ;;
    esac
  done
fi

if [ "$output_format" = "json" ]; then
  read -r _p _c _cand <<< "${STUB_GEMINI_USAGE:-120 20 40}"
  _th="${STUB_GEMINI_THOUGHTS:-0}"
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg response "$response" --arg model "$model" \
      --argjson p "${_p:-0}" --argjson c "${_c:-0}" --argjson cand "${_cand:-0}" \
      --argjson th "${_th:-0}" \
      '{response:$response,
        stats:{models:{($model):{tokens:(
          {prompt:$p, cached:$c, candidates:$cand, total:($p + $cand)}
          | if $th > 0 then . + {thoughts:$th} else . end
        )}}}}'
  else
    printf '{"response":"%s","stats":{"models":{"%s":{"tokens":{"prompt":%s,"cached":%s,"candidates":%s}}}}}\n' \
      "$response" "$model" "${_p:-0}" "${_c:-0}" "${_cand:-0}"
  fi
else
  printf '%s\n' "$response"
fi

# Resolve exit code: per-model override → default.
exit_code="${STUB_ENGINE_EXIT:-0}"
if [ -n "${STUB_ENGINE_EXIT_BY_MODEL:-}" ] && [ -n "$model" ]; then
  IFS='|' read -ra _epairs <<< "$STUB_ENGINE_EXIT_BY_MODEL"
  for _ep in "${_epairs[@]}"; do
    case "$_ep" in
      "$model="*) exit_code="${_ep#"$model="}"; break ;;
    esac
  done
fi
# Per-key override takes precedence over the per-model / default exit code.
if [ -n "${STUB_ENGINE_EXIT_BY_KEY:-}" ] && [ -n "$api_key" ]; then
  IFS='|' read -ra _ekpairs <<< "$STUB_ENGINE_EXIT_BY_KEY"
  for _ekp in "${_ekpairs[@]}"; do
    case "$_ekp" in
      "$api_key="*) exit_code="${_ekp#"$api_key="}"; break ;;
    esac
  done
fi
exit "$exit_code"
