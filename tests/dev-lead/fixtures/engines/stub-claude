#!/usr/bin/env bash
# Configurable via:
#   STUB_ENGINE_RESPONSE, STUB_ENGINE_EXIT, STUB_ENGINE_DELAY
#   STUB_ENGINE_EXIT_BY_MODEL  — pipe-delimited list of "model=exit_code" pairs.
#                                If set and a pair matches --model, that exit
#                                code overrides STUB_ENGINE_EXIT. Models not in
#                                the map fall back to STUB_ENGINE_EXIT.
#   STUB_ENGINE_RESPONSE_BY_MODEL  — pipe-delimited "model=response" pairs,
#                                    same lookup as EXIT_BY_MODEL.
#   STUB_ENGINE_RECORD_MODELS  — if set to a writable path, every --model value
#                                seen is appended as a new line for inspection.
#   STUB_CLAUDE_USAGE  — "input cache_read cache_write output" emitted as the
#                        .usage block when --output-format json is requested.
#                        Default "100 20 30 40".
#   STUB_ENGINE_RECORD_ARGS  — if set to a writable path, the full argv of every
#                              invocation is appended as one line for inspection.
#   STUB_CLAUDE_ERROR_STATUS_BY_MODEL  — pipe-delimited "model=http_status" pairs.
#                        When --output-format json is requested and the model
#                        matches, the envelope is an API error (is_error:true,
#                        api_error_status:<status>, zero usage) with the resolved
#                        response as its .result text — the shape the real CLI
#                        prints for a 404 unknown model or a 400 bad request.
if [ -n "${STUB_ENGINE_RECORD_ARGS:-}" ]; then
  printf '%s\n' "$*" >> "$STUB_ENGINE_RECORD_ARGS" 2>/dev/null || true
fi
model=""
output_format="text"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --print)
      shift ;;
    --permission-mode|--allowed-tools|--disallowed-tools|--max-turns)
      shift; shift ;;
    --output-format)
      output_format="$2"; shift; shift ;;
    --model)
      model="$2"; shift; shift ;;
    *) shift ;;
  esac
done

if [ -n "${STUB_ENGINE_RECORD_MODELS:-}" ]; then
  printf '%s\n' "$model" >> "$STUB_ENGINE_RECORD_MODELS" 2>/dev/null || true
fi

sleep "${STUB_ENGINE_DELAY:-0}"

# Resolve response: per-model override → default.
response="${STUB_ENGINE_RESPONSE:-stub engine response}"
if [ -n "${STUB_ENGINE_RESPONSE_BY_MODEL:-}" ] && [ -n "$model" ]; then
  IFS='|' read -ra _pairs <<< "$STUB_ENGINE_RESPONSE_BY_MODEL"
  for _p in "${_pairs[@]}"; do
    case "$_p" in
      "$model="*) response="${_p#"$model="}"; break ;;
    esac
  done
fi

# Resolve API error status: per-model only (no default).
api_status=""
if [ -n "${STUB_CLAUDE_ERROR_STATUS_BY_MODEL:-}" ] && [ -n "$model" ]; then
  IFS='|' read -ra _spairs <<< "$STUB_CLAUDE_ERROR_STATUS_BY_MODEL"
  for _sp in "${_spairs[@]}"; do
    case "$_sp" in
      "$model="*) api_status="${_sp#"$model="}"; break ;;
    esac
  done
fi

if [ "$output_format" = "json" ] && [ -n "$api_status" ]; then
  # Mirror a failed `claude --print --output-format json` call: the envelope
  # still names the model and carries a usage object.
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg result "$response" --arg model "$model" --argjson st "$api_status" \
      '{type:"result", subtype:"success", is_error:true, api_error_status:$st,
        result:$result, model:$model,
        usage:{input_tokens:0, cache_read_input_tokens:0,
               cache_creation_input_tokens:0, output_tokens:0}}'
  else
    printf '{"type":"result","subtype":"success","is_error":true,"api_error_status":%s,"result":"%s","model":"%s","usage":{"input_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0,"output_tokens":0}}\n' \
      "$api_status" "$response" "$model"
  fi
elif [ "$output_format" = "json" ]; then
  # Mirror `claude --print --output-format json`: a result envelope with usage.
  read -r _in _cr _cw _out <<< "${STUB_CLAUDE_USAGE:-100 20 30 40}"
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg result "$response" \
      --argjson i "${_in:-0}" --argjson cr "${_cr:-0}" \
      --argjson cw "${_cw:-0}" --argjson o "${_out:-0}" \
      '{type:"result", subtype:"success", is_error:false, result:$result,
        usage:{input_tokens:$i, cache_read_input_tokens:$cr,
               cache_creation_input_tokens:$cw, output_tokens:$o}}'
  else
    printf '{"type":"result","result":"%s","usage":{"input_tokens":%s,"cache_read_input_tokens":%s,"cache_creation_input_tokens":%s,"output_tokens":%s}}\n' \
      "$response" "${_in:-0}" "${_cr:-0}" "${_cw:-0}" "${_out:-0}"
  fi
else
  printf '%s\n' "$response"
fi

# Resolve exit code: per-model override → default.
exit_code="${STUB_ENGINE_EXIT:-0}"
if [ -n "${STUB_ENGINE_EXIT_BY_MODEL:-}" ] && [ -n "$model" ]; then
  IFS='|' read -ra _epairs <<< "$STUB_ENGINE_EXIT_BY_MODEL"
  for _ep in "${_epairs[@]}"; do
    case "$_ep" in
      "$model="*) exit_code="${_ep#"$model="}"; break ;;
    esac
  done
fi
exit "$exit_code"
