# Example environment configuration for local development of the PR-review
# automation. Copy to .env and fill in real values locally — never commit a
# real secret. This file is a placeholder-only smoke-test fixture.

# GitHub classic PAT (scopes: repo, read:org, workflow)
GITHUB_TOKEN=<your-token-here>

# Anthropic / Claude Code OAuth token
CLAUDE_CODE_OAUTH_TOKEN=<your-token-here>

# Google / Gemini API key
GEMINI_API_KEY=<your-key-here>

# Database connection (host/user/password filled in locally)
DATABASE_URL=<your-database-url-here>
